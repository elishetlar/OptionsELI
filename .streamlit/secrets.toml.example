# Copy these names into Streamlit Community Cloud's Advanced settings > Secrets.
# Never commit a real .streamlit/secrets.toml file.
# Access is controlled through Streamlit Community Cloud private sharing.
TRADIER_BASE_URL = "https://api.tradier.com/v1"
OPTIONSELI_DEMO_MODE = false
OPTIONSELI_API_CALLS_PER_MINUTE = 50
OPTIONSELI_MAX_EXPIRATIONS_PER_SCAN = 4
# Add TRADIER_API_TOKEN only in the Cloud Secrets editor, never in this file.
OPTIONSELI_PUBLIC_TRADIER_AUTHORIZED = false
OPTIONSELI_PRIVATE_CLOUD_TRADIER_AUTHORIZED = true
