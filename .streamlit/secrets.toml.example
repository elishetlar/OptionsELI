# Copy these names into Streamlit Community Cloud's Advanced settings > Secrets.
# Never commit a real .streamlit/secrets.toml file.
OPTIONSELI_PUBLIC_MODE = true
OPTIONSELI_DEMO_MODE = true
OPTIONSELI_API_CALLS_PER_MINUTE = 50
OPTIONSELI_MAX_EXPIRATIONS_PER_SCAN = 4
# Keep false unless Tradier has granted Partner/public redistribution authorization.
OPTIONSELI_PUBLIC_TRADIER_AUTHORIZED = false
