# Copy this file to .env. Never commit .env.
# Get a sandbox token from https://developer.tradier.com/
TRADIER_API_TOKEN=
TRADIER_ACCOUNT_ID=
TRADIER_BASE_URL=https://sandbox.tradier.com/v1
OPTIONSELI_DEMO_MODE=true
OPTIONSELI_DB_PATH=data/optionseli.db
OPTIONSELI_PUBLIC_MODE=false
OPTIONSELI_API_CALLS_PER_MINUTE=50
OPTIONSELI_MAX_EXPIRATIONS_PER_SCAN=4
