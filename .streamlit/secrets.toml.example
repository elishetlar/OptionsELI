# Copy these names into Streamlit Community Cloud's Advanced settings > Secrets.
# Never commit a real .streamlit/secrets.toml file.
# Replace only through Streamlit Cloud server-side Secrets. Never commit real values.
OPTIONSELI_ALLOWED_EMAILS = ["your-authorized-google-email@example.com"]
OPTIONSELI_DEMO_MODE = true
OPTIONSELI_API_CALLS_PER_MINUTE = 50
OPTIONSELI_MAX_EXPIRATIONS_PER_SCAN = 4
# Keep both authorization flags false unless Tradier grants explicit written permission.
OPTIONSELI_PUBLIC_TRADIER_AUTHORIZED = false
OPTIONSELI_PRIVATE_CLOUD_TRADIER_AUTHORIZED = false

[auth]
redirect_uri = "https://optionseli.streamlit.app/oauth2callback"
cookie_secret = "generate-a-long-random-secret"

[auth.google]
client_id = "your-google-oidc-client-id"
client_secret = "your-google-oidc-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
